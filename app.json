{
  "expo": {
    "name": "roam",
    "slug": "roam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "roam",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.solomonadeoye.roam"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E4D36",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.solomonadeoye.roam"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E4D36",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Roam uses your location to show places near you and how far away they are."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Roam uses the camera so you can add photos to your field notes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "@rnmapbox/maps"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
